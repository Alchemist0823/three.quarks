{
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "moduleFileExtensions": ["ts", "tsx", "js", "mjs"],
    "coveragePathIgnorePatterns": ["/node_modules/", "/test/"],
    "coverageThreshold": {
        "global": {
            "branches": 90,
            "functions": 95,
            "lines": 95,
            "statements": 95
        }
    },
    "extensionsToTreatAsEsm": [".ts"],
    "collectCoverageFrom": ["src/**/*.{js,ts}"],
    "transform": {
        "^.+\\.tsx?$": ["ts-jest", {}],
        "^.+\\.m?js$": [
            "babel-jest",
            {
                "babelrc": false,
                "configFile": false,
                "presets": [["@babel/preset-env", {"targets": {"node": "current"}, "modules": "commonjs"}]]
            }
        ]
    },
    "transformIgnorePatterns": ["/node_modules/(?!three/)"],
    "moduleNameMapper": {
        "\\.wgsl$": "<rootDir>/test/__mocks__/wgslMock.js",
        "^three$": "<rootDir>/../../node_modules/three/build/three.module.js",
        "^three/webgpu$": "<rootDir>/../../node_modules/three/build/three.webgpu.js",
        "^three/tsl$": "<rootDir>/../../node_modules/three/build/three.tsl.js",
        "^three\\.quarks$": "<rootDir>/../three.quarks/src/index.ts",
        "^three\\.quarks/webgpu$": "<rootDir>/../three.quarks/src/webgpu/index.ts",
        "^quarks\\.nodes$": "<rootDir>/src/index.ts"
    }
}
